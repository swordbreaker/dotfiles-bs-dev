# Oh My Zsh (installed by run_once_after_10-mise-install.sh)
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

plugins=(
    git
    ubuntu
    python
    bun
    uv
    zsh-autosuggestions
    mise)

source $ZSH/oh-my-zsh.sh

# Toolchain: mise provides helix, pass-cli, oh-my-pi, starship, zoxide, tv, uv.
# Activate before the completion evals below so those tools resolve.
eval "$(mise activate zsh)"

eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
eval "$(tv init zsh)"
eval "$(uv generate-shell-completion zsh)"

export EDITOR=hx
export VISUAL="$EDITOR"
