# Oh My Zsh (installed by run_once_after_10-mise-install.sh)
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

plugins=(
    git
    ubuntu
    python
    bun
    uv
    zsh-autosuggestions
    mise)

source $ZSH/oh-my-zsh.sh

# Toolchain: mise provides helix, pass-cli, oh-my-pi, starship, zoxide, tv, uv.
# Activate before the completion evals below so those tools resolve.
eval "$(mise activate zsh)"

eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
eval "$(tv init zsh)"
eval "$(uv generate-shell-completion zsh)"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# rust
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

export GCM_CREDENTIAL_STORE=gpg

alias envx="pass-cli run --env-file .env.keys -- dotenvx"
alias renv="envx run -f .env.secrets --"
alias zs="zerostack -n"

zized() {
  local dest
  dest="$(zoxide query -i "$@")" || return
  zed "$dest"
}

if command -v fastfetch >/dev/null 2>&1 && [[ -f ~/Pictures/databs_log.png ]]; then
  fastfetch -l ~/Pictures/databs_log.png --logo-width 20 --logo-padding 5
fi

# opencode (not provisioned by this repo; only if the container has it)
if command -v opencode >/dev/null 2>&1; then
  export PATH="$HOME/.opencode/bin:$PATH"
  eval "$(opencode completion)"
fi

export EDITOR=hx
export VISUAL="$EDITOR"
export ELECTRON_DISABLE_SANDBOX=1

export PATH="$HOME/.config/varlock/bin:$PATH"
